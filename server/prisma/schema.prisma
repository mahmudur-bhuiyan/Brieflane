generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Prisma schema — see docs/PROJECT_PLAN.md §4 for field notes.

enum UserRole {
  SUPER_ADMIN
  PROJECT_MANAGER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum ReportRunStatus {
  pending
  running
  completed
  failed
}

enum TaskHoursReportArchiveStatus {
  drafted
  failed
}

model User {
  id                  String     @id @default(cuid())
  email               String     @unique
  passwordHash        String     @map("password_hash")
  name                String?
  designation         String?
  role                UserRole
  status              UserStatus @default(ACTIVE)
  acUsername          String?    @map("ac_username")
  acPasswordEncrypted String?    @map("ac_password_encrypted") @db.Text
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  reportRuns ReportRun[]
  taskHoursReportArchives TaskHoursReportArchive[]
  assignments ProjectAssignment[]

  @@map("users")
}

model ProjectAssignment {
  userId     String   @map("user_id")
  projectId  String   @map("project_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@index([projectId])
  @@map("project_assignments")
}

model Project {
  id               String        @id @default(cuid())
  acProjectId      Int           @unique @map("ac_project_id")
  name             String
  clientName       String?       @map("client_name")
  clientEmail      String?       @map("client_email")
  reportRecipients Json          @default("[]") @map("report_recipients")
  customMetadata   Json          @default("{}") @map("custom_metadata")
  status           ProjectStatus @default(ACTIVE)
  lastSyncedAt     DateTime?     @map("last_synced_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  reportRuns ReportRun[]
  taskHoursReportArchives TaskHoursReportArchive[]
  assignments ProjectAssignment[]

  @@map("projects")
}

model AppSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  @@map("app_settings")
}

model ReportRun {
  id              String          @id @default(cuid())
  projectId       String          @map("project_id")
  triggeredById   String          @map("triggered_by_id")
  status          ReportRunStatus @default(pending)
  n8nExecutionId  String?         @map("n8n_execution_id")
  errorMessage    String?         @map("error_message") @db.Text
  payloadSnapshot Json            @map("payload_snapshot")
  createdAt       DateTime        @default(now()) @map("created_at")
  completedAt     DateTime?       @map("completed_at")

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  triggeredBy User    @relation(fields: [triggeredById], references: [id])

  @@index([projectId])
  @@index([triggeredById])
  @@map("report_runs")
}

model TaskHoursReportArchive {
  id                 String                       @id @default(cuid())
  projectId          String                       @map("project_id")
  createdById        String                       @map("created_by_id")
  status             TaskHoursReportArchiveStatus @default(drafted)
  recipientEmail     String                       @map("recipient_email")
  subject            String
  periodStart        String?                      @map("period_start")
  periodEnd          String?                      @map("period_end")
  totalBillableHours Decimal?                     @map("total_billable_hours") @db.Decimal(10, 2)
  n8nPayload         Json                         @map("n8n_payload")
  n8nExecutionId     String?                      @map("n8n_execution_id")
  resentFromId       String?                      @map("resent_from_id")
  errorMessage       String?                      @map("error_message") @db.Text
  createdAt          DateTime                     @default(now()) @map("created_at")

  project    Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy  User                     @relation(fields: [createdById], references: [id])
  resentFrom TaskHoursReportArchive?  @relation("ResendChain", fields: [resentFromId], references: [id], onDelete: SetNull)
  resends    TaskHoursReportArchive[] @relation("ResendChain")

  @@index([projectId])
  @@index([createdById])
  @@index([createdAt])
  @@map("task_hours_report_archives")
}
