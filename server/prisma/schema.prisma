generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Prisma schema — see docs/PROJECT_PLAN.md §4 for field notes.

enum UserRole {
  SUPER_ADMIN
  PROJECT_MANAGER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum ReportRunStatus {
  pending
  running
  completed
  failed
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String     @map("password_hash")
  name         String?
  role         UserRole
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  reportRuns ReportRun[]
  assignments ProjectAssignment[]

  @@map("users")
}

model ProjectAssignment {
  userId     String   @map("user_id")
  projectId  String   @map("project_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@index([projectId])
  @@map("project_assignments")
}

model Project {
  id               String        @id @default(cuid())
  acProjectId      Int           @unique @map("ac_project_id")
  name             String
  clientName       String?       @map("client_name")
  clientEmail      String?       @map("client_email")
  reportRecipients Json          @default("[]") @map("report_recipients")
  customMetadata   Json          @default("{}") @map("custom_metadata")
  status           ProjectStatus @default(ACTIVE)
  lastSyncedAt     DateTime?     @map("last_synced_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  reportRuns ReportRun[]
  assignments ProjectAssignment[]

  @@map("projects")
}

model ReportRun {
  id              String          @id @default(cuid())
  projectId       String          @map("project_id")
  triggeredById   String          @map("triggered_by_id")
  status          ReportRunStatus @default(pending)
  n8nExecutionId  String?         @map("n8n_execution_id")
  errorMessage    String?         @map("error_message") @db.Text
  payloadSnapshot Json            @map("payload_snapshot")
  createdAt       DateTime        @default(now()) @map("created_at")
  completedAt     DateTime?       @map("completed_at")

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  triggeredBy User    @relation(fields: [triggeredById], references: [id])

  @@index([projectId])
  @@index([triggeredById])
  @@map("report_runs")
}
